# Binaries
bin/
*.exe
/cortex.exe~

# Database files
*.db
*.db-wal
*.db-shm

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Go
vendor/

# Web client
/node_modules/
web/node_modules/
web/dist/
web/*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts

# Coverage profiles (go test -coverprofile / go tool cover).
# The broad /coverage* pattern catches ad-hoc names like coverage-w8,
# coverage.html, etc. without listing each typo individually.
/cover
/cover.*
/coverage*
*.prof

# Claude local settings
.claude/settings.local.json

# Ignore dotfiles except specific ones
.*
!.github/
!.claude-plugin/
!.gitignore
!.dockerignore
!.goreleaser.yaml
!web/.env.example
