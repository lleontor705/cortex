# Cortex Configuration Example
# Copy this file to cortex.yaml or ~/.cortex/config.yaml

# Server identification
server:
  name: cortex
  version: 2.0.0
  storage:
    driver: postgres
    # Runtime DSN. Keep this login NOSUPERUSER/NOBYPASSRLS.
    dsn: postgres://cortex_test:cortex_test@localhost:5432/cortex_test?sslmode=disable
    # Required outside bootstrap_development. Its PostgreSQL role must differ
    # from the runtime role; it is used for migration/bootstrap and then closed.
    migration_dsn: postgres://cortex_bootstrap:cortex_bootstrap@localhost:5432/cortex_test?sslmode=disable
  tenant_id: "00000000-0000-0000-0000-000000000001"
  workspace_id: "00000000-0000-0000-0000-000000000002"
  principal_subject: "00000000-0000-0000-0000-000000000003"
  grant_digest: local-development-grant
  grant_version: 1
  roles: [owner]
  scopes: [workspaces:read]
  project_ids: [demo]
  classification_clearance: [project]
  # Docker smoke tests may set this true to provision their fixed development
  # tenant. Only this development mode may omit migration_dsn and reuse dsn.
  bootstrap_development: false

# Database configuration
database:
  # Path to SQLite database file (ignored if in_memory is true)
  path: cortex.db
  
  # Use in-memory database (useful for testing)
  in_memory: false
  
  # SQLite pragma settings for performance optimization
  pragma:
    # WAL mode for better concurrent performance
    journal_mode: WAL
    
    # Balance between safety and performance
    synchronous: NORMAL
    
    # Cache size in pages (negative = kilobytes, -64000 = 64MB)
    cache_size: -64000
    
    # Enable foreign key constraints
    foreign_keys: true
    
    # Store temporary tables in memory
    temp_store: MEMORY
    
    # Memory-mapped I/O size (268435456 = 256MB)
    mmap_size: 268435456

# MCP (Model Context Protocol) server configuration
mcp:
  # Enable MCP server
  enabled: true

  # Optional remote proxy. When enabled, `cortex mcp` does not open SQLite;
  # it forwards the published MCP tools over local stdio instead.
  remote:
    enabled: false
    # Bearer destination: HTTPS is required for non-loopback hosts. Plain
    # HTTP is only allowed on strict loopback (127.0.0.0/8, [::1], or the
    # exact "localhost" name). Redirects that downgrade the scheme or change
    # the origin are blocked before the token is forwarded.
    url: ""
    token_env: CORTEX_REMOTE_TOKEN
    timeout: 30s

# Optional local-first replication. Cortex continues serving SQLite while a
# background worker pushes local changes and pulls server changes.
sync:
  enabled: false
  # Bearer destination under the same transport policy as mcp.remote.url:
  # HTTPS off-loopback, plain HTTP only on strict loopback, and redirects
  # must not downgrade the scheme or change the origin.
  url: "https://cortex.example.com"
  token_env: CORTEX_REMOTE_TOKEN
  interval: 30s
  timeout: 30s

# HTTP API server configuration
http:
  # Enable HTTP API server
  enabled: true
  
  # Port to listen on
  port: 7438
  
  # Host to bind to (use 0.0.0.0 for all interfaces)
  host: 127.0.0.1

  # Optional API token. Required if you bind the API to a non-local host.
  token: change-me

  # Browser origins allowed to call the API (comma-separated via environment).
  allowed_origins: []

# Logging configuration
logging:
  # Log level: debug, info, warn, error
  level: info
  
  # Log format: json, text, plain
  format: json
