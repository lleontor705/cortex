# =============================================================================
# 🧠 CORTEX - ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================
# Copy this file to .env:
#   cp .env.example .env
#   docker compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE & PERSISTENCE (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=cortex_bootstrap
POSTGRES_PASSWORD=cortex_bootstrap
POSTGRES_DB=cortex_test
POSTGRES_APP_USER=cortex_test
POSTGRES_APP_PASSWORD=cortex_test

# Connection strings for Docker & Server runtime
CORTEX_SERVER_STORAGE_DSN=postgres://cortex_test:cortex_test@postgres:5432/cortex_test?sslmode=disable
CORTEX_SERVER_STORAGE_MIGRATION_DSN=postgres://cortex_bootstrap:cortex_bootstrap@postgres:5432/cortex_test?sslmode=disable

# -----------------------------------------------------------------------------
# 2. SERVER & HTTP API
# -----------------------------------------------------------------------------
CORTEX_HTTP_PORT=7438
# Network interface to bind ('0.0.0.0' for containers, 'localhost' for local workstation)
# CORTEX_HTTP_HOST=0.0.0.0

# Authentication Bearer Token (Leave empty to auto-generate a secure token)
CORTEX_HTTP_TOKEN=

# Allowed CORS origins for Web UI (comma-separated)
CORTEX_HTTP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000

# Logging verbosity ('debug', 'info', 'warn', 'error') and format ('json', 'text', 'plain')
# CORTEX_LOGGING_LEVEL=info
# CORTEX_LOGGING_FORMAT=json

# -----------------------------------------------------------------------------
# 3. BOOTSTRAP & MULTI-TENANCY (Docker / Server)
# -----------------------------------------------------------------------------
# Auto-generate tenant, workspace, and owner credential on first start:
# CORTEX_SERVER_AUTO_BOOTSTRAP=true
# CORTEX_SERVER_BOOTSTRAP_DEVELOPMENT=true
# Enable SaaS multi-tenant isolation (tenant/workspace from Bearer grants):
# CORTEX_SERVER_MULTI_TENANT=false

# -----------------------------------------------------------------------------
# 4. EMBEDDINGS (Vector indexing & Semantic Search)
# -----------------------------------------------------------------------------
# Providers: 'none' (default BM25/FTS5), 'openai', 'ollama', 'gemini'
CORTEX_EMBEDDING_PROVIDER=none
CORTEX_EMBEDDING_MODEL=text-embedding-3-small
CORTEX_EMBEDDING_BASE_URL=
# Standard API credential for embedding provider:
CORTEX_EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# 5. LLM (Agent Reasoning, Extraction & Synthesis)
# -----------------------------------------------------------------------------
# Providers: 'openai', 'anthropic', 'gemini', 'ollama', 'groq', 'deepseek'
CORTEX_LLM_PROVIDER=openai
CORTEX_LLM_MODEL=gpt-4o-mini
CORTEX_LLM_BASE_URL=
# Standard API credential for LLM provider:
CORTEX_LLM_API_KEY=

# -----------------------------------------------------------------------------
# 6. EXTERNAL VECTOR ADAPTERS (Server-Only: pgvector / Qdrant)
# -----------------------------------------------------------------------------
# Active vector provider: 'none' (default), 'pgvector', 'qdrant'
# CORTEX_VECTOR_PROVIDER=none

# pgvector parameters (when CORTEX_VECTOR_PROVIDER=pgvector):
# CORTEX_VECTOR_PGVECTOR_SCHEMA=cortex_vector
# CORTEX_VECTOR_PGVECTOR_TABLE=embeddings
# CORTEX_VECTOR_PGVECTOR_INDEX_TYPE=hnsw

# Qdrant parameters (when CORTEX_VECTOR_PROVIDER=qdrant):
# CORTEX_VECTOR_QDRANT_HOST=localhost
# CORTEX_VECTOR_QDRANT_PORT=6334
# CORTEX_VECTOR_QDRANT_COLLECTION=cortex
# CORTEX_VECTOR_QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# 7. WEB UI (Control Room Next.js 15)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CORTEX_SERVER_URL=http://localhost:7438
