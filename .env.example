# =============================================================================
# 🧠 CORTEX - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env to configure your local, server, or Docker deployment:
#   cp .env.example .env
#
# Precedence order: Environment Variables > Config File (cortex.yaml) > Defaults
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DOCKER & POSTGRESQL INFRASTRUCTURE
# -----------------------------------------------------------------------------
# PostgreSQL superuser/migration bootstrap credentials:
POSTGRES_USER=cortex_bootstrap
POSTGRES_PASSWORD=cortex_bootstrap
POSTGRES_DB=cortex_test
POSTGRES_PORT=5432

# Non-superuser application role (NOSUPERUSER, NOBYPASSRLS) used at runtime:
POSTGRES_APP_USER=cortex_test
POSTGRES_APP_PASSWORD=cortex_test

# -----------------------------------------------------------------------------
# 2. CORTEX SERVER RUNTIME & PERSISTENCE
# -----------------------------------------------------------------------------
# Storage driver: 'postgres' (server mode) or 'sqlite' (local CLI/TUI mode)
CORTEX_SERVER_STORAGE_DRIVER=postgres

# Non-privileged runtime connection (Used for normal operations, strictly RLS-enforced)
CORTEX_SERVER_STORAGE_DSN=postgres://cortex_test:cortex_test@localhost:5432/cortex_test?sslmode=disable

# Privileged connection for database migrations (Closed immediately after startup preflight)
CORTEX_SERVER_STORAGE_MIGRATION_DSN=postgres://cortex_bootstrap:cortex_bootstrap@localhost:5432/cortex_test?sslmode=disable

# -----------------------------------------------------------------------------
# 3. MULTI-TENANCY, WORKSPACE & IDENTITY PRIVILEGES
# -----------------------------------------------------------------------------
# Docker Auto-Bootstrap: when 'true', auto-creates default tenant/workspace/token on first start
CORTEX_SERVER_AUTO_BOOTSTRAP=true
CORTEX_SERVER_BOOTSTRAP_DEVELOPMENT=true

# Multi-Tenant isolation mode ('false' for single-tenant dev, 'true' for strict enterprise SaaS)
CORTEX_SERVER_MULTI_TENANT=false

# Stable tenant & workspace IDs (UUIDv4)
CORTEX_TENANT_ID=00000000-0000-0000-0000-000000000001
CORTEX_WORKSPACE_ID=00000000-0000-0000-0000-000000000002
CORTEX_PRINCIPAL_SUBJECT=00000000-0000-0000-0000-000000000003

# -----------------------------------------------------------------------------
# 4. HTTP API & MCP TRANSPORT
# -----------------------------------------------------------------------------
CORTEX_HTTP_ENABLED=true
CORTEX_HTTP_HOST=0.0.0.0
CORTEX_HTTP_PORT=7438

# Authentication Bearer Token for REST API (/api/*) and Streamable HTTP MCP (/mcp)
# (Leave blank during auto-bootstrap to generate a cryptographically random token)
CORTEX_HTTP_TOKEN=cortex_secret_admin_token_change_me

# Allowed CORS origins for browser web clients (comma-separated)
CORTEX_HTTP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost:5173,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 5. UNIFIED AI & LLM PROVIDER CONFIGURATION
# -----------------------------------------------------------------------------
# Providers: 'none', 'ollama', 'openai', 'anthropic', 'openrouter', 'groq', 'deepseek', 'custom'
CORTEX_AI_PROVIDER=none
CORTEX_AI_MODEL=gpt-4o-mini
CORTEX_AI_BASE_URL=

# Conversational Agent Server-side LLM configuration
CORTEX_LLM_PROVIDER=openai
CORTEX_LLM_MODEL=gpt-4o-mini
CORTEX_LLM_API_KEY=
CORTEX_LLM_BASE_URL=

# Provider-specific API Keys (used when corresponding provider is active):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# -----------------------------------------------------------------------------
# 6. VECTOR SEARCH & DENSE RETRIEVAL ADAPTERS
# -----------------------------------------------------------------------------
# Vector backend adapter: 'none' (lexical BM25/FTS5 only), 'pgvector', 'qdrant'
CORTEX_SERVER_PROVIDER_VECTOR=none
CORTEX_SEARCH_EMBEDDING_PROVIDER=none

# Qdrant External Vector DB configuration (if CORTEX_SERVER_PROVIDER_VECTOR=qdrant)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# 7. WEB UI / CONTROL ROOM (NEXT.JS 15)
# -----------------------------------------------------------------------------
# Port & environment for Web UI
PORT=3000
NODE_ENV=production
HOSTNAME=0.0.0.0

# Pre-configured endpoint compilation for browser frontend
NEXT_PUBLIC_CORTEX_MANAGED_ENDPOINT=false
NEXT_PUBLIC_CORTEX_SERVER_URL=http://localhost:7438

# -----------------------------------------------------------------------------
# 8. LOCAL CLIENT REPLICATION & MCP PROXY
# -----------------------------------------------------------------------------
# Path to local SQLite database (for CLI / TUI / local usage)
CORTEX_DATABASE_PATH=~/.cortex/cortex.db

# Remote Sync (Replication to a centralized Cortex server)
CORTEX_SYNC_ENABLED=false
CORTEX_SYNC_URL=https://cortex.example.com
CORTEX_SYNC_TOKEN_ENV=CORTEX_REMOTE_TOKEN
CORTEX_SYNC_INTERVAL=30s

# Remote MCP stdio proxy
CORTEX_MCP_REMOTE_ENABLED=false
CORTEX_MCP_REMOTE_URL=https://cortex.example.com/mcp
CORTEX_MCP_REMOTE_TOKEN_ENV=CORTEX_REMOTE_TOKEN
