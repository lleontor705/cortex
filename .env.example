# =============================================================================
# 🧠 CORTEX - ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================
# Copy this file to .env:
#   cp .env.example .env
#   docker compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE & PERSISTENCE (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=cortex_bootstrap
POSTGRES_PASSWORD=cortex_bootstrap
POSTGRES_DB=cortex_test
POSTGRES_APP_USER=cortex_test
POSTGRES_APP_PASSWORD=cortex_test

# Connection strings for Docker & Server runtime
CORTEX_SERVER_STORAGE_DSN=postgres://cortex_test:cortex_test@postgres:5432/cortex_test?sslmode=disable
CORTEX_SERVER_STORAGE_MIGRATION_DSN=postgres://cortex_bootstrap:cortex_bootstrap@postgres:5432/cortex_test?sslmode=disable

# -----------------------------------------------------------------------------
# 2. SERVER & HTTP API
# -----------------------------------------------------------------------------
CORTEX_HTTP_PORT=7438

# Authentication Bearer Token (Leave empty to auto-generate a secure token)
CORTEX_HTTP_TOKEN=

# Allowed CORS origins for Web UI (comma-separated)
CORTEX_HTTP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 3. EMBEDDINGS (Vector indexing & Semantic Search)
# -----------------------------------------------------------------------------
# Providers: 'none' (default BM25/FTS5), 'openai', 'ollama', 'gemini'
CORTEX_EMBEDDING_PROVIDER=none
CORTEX_EMBEDDING_MODEL=text-embedding-3-small
CORTEX_EMBEDDING_BASE_URL=

# -----------------------------------------------------------------------------
# 4. LLM (Agent Reasoning, Extraction & Synthesis)
# -----------------------------------------------------------------------------
# Providers: 'openai', 'anthropic', 'gemini', 'ollama', 'groq', 'deepseek'
CORTEX_LLM_PROVIDER=openai
CORTEX_LLM_MODEL=gpt-4o-mini
CORTEX_LLM_BASE_URL=

# -----------------------------------------------------------------------------
# 5. API KEYS (Shared by Embedding and LLM providers)
# -----------------------------------------------------------------------------
# Uncomment and set the API key for your active provider:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...

# -----------------------------------------------------------------------------
# 6. WEB UI (Control Room Next.js 15)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CORTEX_SERVER_URL=http://localhost:7438
