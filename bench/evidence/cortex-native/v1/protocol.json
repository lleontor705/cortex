    },
    "dispersion": {
      "method": "retain-all-samples-min-max-mean-range-sample-standard-deviation/v1",
      "outlier_policy": "retain_and_disclose_never_discard"
    },
    "unavailable_measurement_policy": "explicit_unavailable_never_numeric_zero",
