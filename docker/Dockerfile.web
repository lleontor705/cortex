# Multi-platform builder: uses host architecture ($BUILDPLATFORM) so Next.js bundling
# runs at native speed without slow/hanging QEMU emulation for linux/arm64 targets.
FROM --platform=$BUILDPLATFORM node:22-alpine AS builder
WORKDIR /app

# Cache package manifests and dependencies first
COPY web/package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# Public variables compiled into browser bundle during Next.js build.
# Placed AFTER dependency installation so changing ARGs does not invalidate npm ci cache.
ARG NEXT_PUBLIC_CORTEX_MANAGED_ENDPOINT=false
ARG NEXT_PUBLIC_CORTEX_SERVER_URL=http://localhost:7438
ENV NEXT_PUBLIC_CORTEX_MANAGED_ENDPOINT=$NEXT_PUBLIC_CORTEX_MANAGED_ENDPOINT
ENV NEXT_PUBLIC_CORTEX_SERVER_URL=$NEXT_PUBLIC_CORTEX_SERVER_URL
ENV NEXT_TELEMETRY_DISABLED=1

# Copy source code and build production standalone bundles
COPY web/ ./
RUN mkdir -p public
RUN --mount=type=cache,target=/app/.next/cache \
    npm run build

# Multi-platform runtime: runs on the target architecture ($TARGETPLATFORM)
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Add non-root node user
USER node

COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/health || exit 1
CMD ["node", "server.js"]
