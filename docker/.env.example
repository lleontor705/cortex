# =============================================================================
# CORTEX production compose - environment template
# =============================================================================
# Copy to docker/.env (docker compose -f docker/docker-compose.prod.yml reads
# it from the compose file's directory) and replace the placeholders:
#
#   cp docker/.env.example docker/.env
#
# Everything not listed below has the deployed-production default baked into
# docker-compose.prod.yml, so only secrets are strictly required.
# =============================================================================

# --- REQUIRED SECRETS (Nan gateway keys; the literal placeholder values will
# --- authenticate nothing - replace all three before first start) ---
CORTEX_LLM_API_KEY=REPLACE_WITH_NAN_API_KEY
CORTEX_EMBEDDING_API_KEY=REPLACE_WITH_NAN_API_KEY
CORTEX_RERANK_API_KEY=REPLACE_WITH_NAN_API_KEY

# --- Postgres plumbing (change for anything beyond a protected host) ---
# Rotation caveat: role passwords are baked in by the one-shot init script at
# first start; changing them later requires altering the roles in the DB too.
POSTGRES_USER=cortex_bootstrap
POSTGRES_PASSWORD=change_me_bootstrap
POSTGRES_DB=cortex
POSTGRES_APP_USER=cortex_app
POSTGRES_APP_PASSWORD=change_me_app
POSTGRES_MIGRATION_USER=cortex_migration
POSTGRES_MIGRATION_PASSWORD=change_me_migration

# --- Optional overrides (defaults match the deployed Railway stack) ---
# CORTEX_HTTP_PORT=7438
# CORTEX_HTTP_TOKEN=                      # empty => auto-generated on first start, printed once in logs
# CORTEX_SERVER_AUTO_BOOTSTRAP=true
# CORTEX_SERVER_BOOTSTRAP_DEVELOPMENT=false
# CORTEX_HTTP_ALLOWED_ORIGINS=
